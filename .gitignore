# NEVER commit firmware or firmware-derived blobs. This project distributes NO firmware.
# Bring your own FwPkt; keep it out of the repo.
FwPkt/
FwPkt*.zip
*.ubifs
*.bin
uImage
config
firmwareInfo
crcInfo

# Build inputs/outputs
in/
out/
work/
build/
*.so
pgphoto*
ptp2*
appfs*
*.img

# ...but DO track the source files shipped inside the container image that the
# broad build-artifact patterns above would otherwise swallow. These are the
# author's own scripts/wrapper (NOT built binaries) and must be in the repo or a
# fresh clone cannot build the image.
!container/ondisk/pgphoto.wrapper

# Toolchain source cache
src/libgphoto2-*/
*.tar.xz
*.tar.bz2
*.tar.gz

# OS / editor
__pycache__/
.DS_Store
Thumbs.db
*.swp

# build caches for the wifi userspace cross-build (sources are fetched)
.cache-wifi/
out/wifi/

# Generated from container/astro/webui/ by embed_webui.py at build time.
# Not committed: it is a byte-for-byte function of the sources beside it, and a
# stale checked-in copy would silently ship an old UI with new C.
container/astro/webui.h
